# ============================================================
# TEMPLATE .env UNTUK PRODUCTION / DEPLOY SERVER
# Salin file ini ke ROOT project sebagai ".env"
# Isi semua nilai yang kosong sebelum deploy.
# JANGAN commit file .env ke git.
# ============================================================

CI_ENVIRONMENT = production

# ── App ──────────────────────────────────────────────────────
app.baseURL           = https://DOMAIN_ANDA.com/
app.superadminEmail   = EMAIL_SUPERADMIN@domain.com
app.adminEmail        = EMAIL_SUPERADMIN@domain.com
app.twoFactorEnabled  = true

# ── Database PostgreSQL ───────────────────────────────────────
database.default.hostname = 127.0.0.1
database.default.database = geoportal
database.default.username = postgres
database.default.password = GANTI_DENGAN_PASSWORD_KUAT
database.default.DBDriver = Postgre
database.default.schema   = geoportal,public
database.default.port     = 5432

# ── Auth API (Node.js service) ────────────────────────────────
authApi.baseUrl   = http://127.0.0.1:4010
authApi.sharedKey = GANTI_DENGAN_RANDOM_64_HEX

# ── Email / SMTP ──────────────────────────────────────────────
email.fromEmail  = noreply@DOMAIN_ANDA.com
email.fromName   = GravPort
email.protocol   = smtp
email.mailType   = html
email.SMTPHost   = smtp.gmail.com
email.SMTPUser   = EMAIL_SMTP@gmail.com
email.SMTPPass   = APP_PASSWORD_GMAIL
email.SMTPPort   = 587
email.SMTPCrypto = tls

# ── Midtrans (PRODUCTION keys dari dashboard.midtrans.com) ───
midtrans.serverKey    = Mid-server-PRODUCTION_KEY
midtrans.clientKey    = Mid-client-PRODUCTION_KEY
midtrans.isProduction = true
